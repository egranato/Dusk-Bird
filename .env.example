# ── Application ───────────────────────────────────────────────────────────────
NODE_ENV=production
# Comma-separated list of allowed frontend origins.
# Include your Firebase Hosting domain (e.g. https://duskbird.com)
# and any other origins you want to permit.
ALLOWED_ORIGINS=https://duskbird.com

# ── Database (PostgreSQL) ──────────────────────────────────────────────────────
DB_HOST=postgres
DB_PORT=5432
DB_NAME=duskbird
DB_USER=duskbird_user
DB_PASSWORD=change_me_strong_password

# ── JWT ────────────────────────────────────────────────────────────────────────
# Must be at least 32 random characters. Generate with: openssl rand -hex 32
JWT_SECRET=change_me_minimum_32_char_random_string
JWT_EXPIRES_IN=8h

# ── MinIO ──────────────────────────────────────────────────────────────────────
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ROOT_USER=duskbird_admin
MINIO_ROOT_PASSWORD=change_me_strong_password
MINIO_BUCKET=duskbird

# ── NUC Storage ────────────────────────────────────────────────────────────────
# Absolute path on the NUC HOST to the drive where media files will be stored.
# This is bind-mounted into the MinIO container.
# Example: /mnt/storage1  or  /home/ethan/media
NUC_STORAGE_PATH=/mnt/storage1

# ── Caddy / TLS ────────────────────────────────────────────────────────────────
DOMAIN=yourdomain.com
ACME_EMAIL=admin@yourdomain.com

# ── Cloudflare DNS-01 (Option C TLS only) ─────────────────────────────────────
# Create a token at dash.cloudflare.com → My Profile → API Tokens
# Permissions needed: Zone → DNS → Edit (for your zone)
CLOUDFLARE_API_TOKEN=

# ── Admin Seed ─────────────────────────────────────────────────────────────────
# Used only by: docker compose exec api npm run seed:admin
# Change this password immediately after first login.
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_INITIAL_PASSWORD=change_me_on_first_login
